# LaunchBrief environment field inventory. API URLs use Volcano production.
# Replace the Trellini IDs below for your target board and column.
# Empty values require your credentials or a
# confirmed integration setting. Keep a populated .env local and uncommitted.
# Store Stripe values here alongside the other server settings.
# Deploy them to Volcano with: volcano cloud variables deploy --file .env
# Hosted Functions read process.env populated by project variables.

# LaunchBrief Volcano project. Keep the service key server-side.
# Functions and the browser share NEXT_PUBLIC_VOLCANO_API_URL and anon key.
# Only the anon key is public; never use a service key for it.
VOLCANO_SERVICE_KEY=
VOLCANO_DATABASE=app
NEXT_PUBLIC_VOLCANO_API_URL=https://api.volcano.dev
NEXT_PUBLIC_VOLCANO_ANON_KEY=
NEXT_PUBLIC_VOLCANO_DATABASE=app
# Set to your deployed LaunchBrief frontend origin.
APP_BASE_URL=

# TanStack AI Anthropic adapter. Keep the API key server-side.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5.5

# Server-side test switch. Only the literal value false bypasses credit spending;
# unset or true keeps the paid gate. Sign-in remains required.
LAUNCHBRIEF_CREDIT_GATE_ENABLED=true

# Shared hosted Trellini MCP: no Trellini service key or database settings needed.
TRELLINI_MCP_TRANSPORT=http
# HTTP mode only: confirmed MCP endpoint and your own user session token.
# The board website https://trellini.volcano.run is not the MCP endpoint.
TRELLINI_MCP_URL=https://trellini.volcano.run/mcp
TRELLINI_ACCESS_TOKEN=

TRELLINI_BOARD_ID=f8a06b4a-19ba-477b-a9a5-d3e942605736
TRELLINI_COLUMN_ID=dc83b534-1d38-4754-96cd-852827ce1c8d

# Stripe one-time credit pack. Needed when the credit gate is enabled.
# Use a one-time Stripe Price ID whose purchase grants CREDITS_PER_PACK credits.
# Register the deployed stripe-webhook URL in Stripe to obtain its signing secret.
# Keep all four values server-side; a Stripe publishable key is not used.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=price_1ULCbePUwxhzJA7t25FgsIzG
STRIPE_WEBHOOK_SECRET=
CREDITS_PER_PACK=5
