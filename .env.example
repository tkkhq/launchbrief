# LaunchBrief environment field inventory. Copy values only to the intended
# project or runtime; keep the populated .env file local and uncommitted.

# LaunchBrief Volcano project. Keep the service key server-side.
VOLCANO_API_URL=
VOLCANO_ANON_KEY=
VOLCANO_SERVICE_KEY=
VOLCANO_DATABASE=app
NEXT_PUBLIC_VOLCANO_API_URL=
NEXT_PUBLIC_VOLCANO_ANON_KEY=
NEXT_PUBLIC_VOLCANO_DATABASE=app
APP_BASE_URL=

# Claude Agent SDK. Server-side only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Separate Trellini project. This service key must belong to Trellini.
TRELLINI_API_URL=
TRELLINI_SERVICE_KEY=
TRELLINI_DATABASE=trellini
TRELLINI_BOARD_ID=
TRELLINI_COLUMN_ID=
# Optional, only after Trellini establishes a card deep-link format.
TRELLINI_CARD_URL_TEMPLATE=

# Stripe one-time credit pack. All values are server-side.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
CREDITS_PER_PACK=
