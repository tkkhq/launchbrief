# LaunchBrief environment field inventory. The public URLs and Trellini IDs
# below belong to this repository's current Volcano projects; replace them for
# an instance in your own account. Empty values require your credentials or a
# confirmed integration setting. Keep a populated .env local and uncommitted.

# LaunchBrief Volcano project. Keep the service key server-side.
VOLCANO_API_URL=https://api.staging.volcano.dev
VOLCANO_ANON_KEY=
VOLCANO_SERVICE_KEY=
VOLCANO_DATABASE=app
NEXT_PUBLIC_VOLCANO_API_URL=https://api.staging.volcano.dev
NEXT_PUBLIC_VOLCANO_ANON_KEY=
NEXT_PUBLIC_VOLCANO_DATABASE=app
APP_BASE_URL=https://eff19528-a1be-4397-a099-bf3729dd275e.frontends.staging.volcano.run/

# TanStack AI Anthropic adapter. Keep the API key server-side.
# ANTHROPIC_BASE_URL is optional for a compatible proxy operated by the key owner.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=

# Server-side test switch. Only the literal value false bypasses credit spending;
# unset or true keeps the paid gate. Sign-in remains required.
LAUNCHBRIEF_CREDIT_GATE_ENABLED=true

# Separate Trellini project. This service key must belong to Trellini.
TRELLINI_API_URL=https://api.staging.volcano.dev
TRELLINI_SERVICE_KEY=
TRELLINI_DATABASE=trellini
TRELLINI_BOARD_ID=b1909bd4-1c07-4d32-b1cc-c98cfece1bcd
TRELLINI_COLUMN_ID=0b045138-332e-4d62-9c92-0633cb7562c0
# Optional, only after Trellini establishes a card deep-link format.
TRELLINI_CARD_URL_TEMPLATE=

# Stripe one-time credit pack. Needed when the credit gate is enabled.
# Use a one-time Stripe Price ID whose purchase grants CREDITS_PER_PACK credits.
# Register the deployed stripe-webhook URL in Stripe to obtain its signing secret.
# Keep all four values server-side; a Stripe publishable key is not used.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
CREDITS_PER_PACK=
