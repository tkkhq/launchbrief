# Volcano local values from your project. Never commit real keys.
VOLCANO_API_URL=http://localhost:8000
VOLCANO_ANON_KEY=ak-...
VOLCANO_SERVICE_KEY=sk-...
VOLCANO_DATABASE=app
NEXT_PUBLIC_VOLCANO_API_URL=http://localhost:8000
NEXT_PUBLIC_VOLCANO_ANON_KEY=ak-...
NEXT_PUBLIC_VOLCANO_DATABASE=app

# Claude Agent SDK, server only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Trellini hosted Streamable HTTP MCP endpoint and a Trellini user bearer token.
TRELLINI_MCP_URL=
TRELLINI_API_URL=
TRELLINI_ANON_KEY=
TRELLINI_AGENT_EMAIL=
TRELLINI_AGENT_PASSWORD=
TRELLINI_BOARD_ID=
TRELLINI_COLUMN_ID=
# Optional; exact task deep-link pattern must be provided by Trellini.
TRELLINI_CARD_URL_TEMPLATE=

# Public URL of LaunchBrief, used in Trellini task notes and Checkout redirects.
APP_BASE_URL=http://localhost:3000

# Stripe server values. Price is one pack; set pack size to the purchased credit count.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
CREDITS_PER_PACK=10
