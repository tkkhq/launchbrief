# Volcano local values from your project. Never commit real keys.
VOLCANO_API_URL=http://localhost:8000
VOLCANO_ANON_KEY=ak-...
VOLCANO_SERVICE_KEY=sk-...
VOLCANO_DATABASE=app
NEXT_PUBLIC_VOLCANO_API_URL=http://localhost:8000
NEXT_PUBLIC_VOLCANO_ANON_KEY=ak-...
NEXT_PUBLIC_VOLCANO_DATABASE=app

# TanStack AI Anthropic adapter, server only. Set ANTHROPIC_BASE_URL only for a compatible proxy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=
# Required for Anthropic keys that are not scoped to one workspace.
ANTHROPIC_WORKSPACE_ID=

# Set false for signed-in testing without Stripe or credits. Default is true.
LAUNCHBRIEF_CREDIT_GATE_ENABLED=true

# Trellini standalone MCP runs as a local child process with its project service key.
TRELLINI_API_URL=
TRELLINI_SERVICE_KEY=
TRELLINI_DATABASE=trellini
TRELLINI_BOARD_ID=
TRELLINI_COLUMN_ID=
# Optional; exact task deep-link pattern must be provided by Trellini.
TRELLINI_CARD_URL_TEMPLATE=

# Public URL of LaunchBrief, used in Trellini task notes and Checkout redirects.
APP_BASE_URL=http://localhost:3000

# Stripe server values for paid mode. Price is one pack; set pack size to its credit count.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
CREDITS_PER_PACK=
