# Volcano local values from your project. Never commit real keys.
VOLCANO_SERVICE_KEY=sk-...
VOLCANO_DATABASE=app
NEXT_PUBLIC_VOLCANO_API_URL=http://localhost:8000
NEXT_PUBLIC_VOLCANO_ANON_KEY=ak-...
NEXT_PUBLIC_VOLCANO_DATABASE=app

# TanStack AI Anthropic adapter, server only.
ANTHROPIC_API_KEY=
# Required for the lab API key; sent as the anthropic-workspace-id header.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5.5

# Set false for signed-in testing without Stripe or credits. Default is true.
LAUNCHBRIEF_CREDIT_GATE_ENABLED=true

# Shared hosted Trellini MCP. Use your own signed-in user token.
# Owner-operated stdio settings are documented separately in README.md.
TRELLINI_MCP_TRANSPORT=http
TRELLINI_MCP_URL=https://trellini.volcano.run/mcp
TRELLINI_ACCESS_TOKEN=
TRELLINI_BOARD_ID=
TRELLINI_COLUMN_ID=

# Public URL of LaunchBrief, used in Trellini task notes and Checkout redirects.
APP_BASE_URL=http://localhost:3000

# Stripe server values for paid mode. Price is one pack; set pack size to its credit count.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
CREDITS_PER_PACK=
