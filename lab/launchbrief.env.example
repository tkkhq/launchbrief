# Copy this file to the repository-root .env. Fill every required blank.
# .env is gitignored. Never share or commit a populated copy.
# Use the API URL for your Volcano environment, not another participant's project.

# LaunchBrief project: the anon key is browser-visible; the service key is not.
VOLCANO_SERVICE_KEY=
VOLCANO_DATABASE=app
NEXT_PUBLIC_VOLCANO_API_URL=
NEXT_PUBLIC_VOLCANO_ANON_KEY=
NEXT_PUBLIC_VOLCANO_DATABASE=app

# Complete after the first frontend deploy, using its URL from the CLI.
APP_BASE_URL=

# Each participant needs an authorized model credential or a facilitator proxy.
# This repository does not supply a proxy or hide a key from project admins.
ANTHROPIC_API_KEY=
# Required for the lab API key; sent as the anthropic-workspace-id header.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5.5

# Lab mode: idea, follow-up, and PPT creation each spend one credit.
LAUNCHBRIEF_CREDIT_GATE_ENABLED=true

# Shared board: https://trellini.volcano.run
# Copy the confirmed MCP endpoint from the site's MCP panel or lab handout.
# The site URL is not an MCP endpoint. Never copy the owner's service key.
TRELLINI_MCP_TRANSPORT=http
TRELLINI_MCP_URL=https://trellini.volcano.run/mcp
# Your own signed-in Trellini session token, server-only. Refresh when expired.
TRELLINI_ACCESS_TOKEN=
# Shared destination supplied by the facilitator; do not use another instance's IDs.
TRELLINI_BOARD_ID=
TRELLINI_COLUMN_ID=

# Stripe test-mode checkout. Keep credentials server-only.
# Supplied one-time lab Price: five credits per pack.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=price_1ULCbePUwxhzJA7t25FgsIzG
CREDITS_PER_PACK=5
# Fill after deploying stripe-webhook and registering its actual HTTP URL.
STRIPE_WEBHOOK_SECRET=
