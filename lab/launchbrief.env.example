# Copy this file to the repository-root .env.cloud. Fill every required blank.
# .env.cloud is gitignored. Never share or commit a populated copy.
# Use the API URL for your Volcano environment, not another participant's project.

# LaunchBrief project: the anon key is browser-visible; the service key is not.
VOLCANO_API_URL=
VOLCANO_ANON_KEY=
VOLCANO_SERVICE_KEY=
VOLCANO_DATABASE=app
NEXT_PUBLIC_VOLCANO_API_URL=
NEXT_PUBLIC_VOLCANO_ANON_KEY=
NEXT_PUBLIC_VOLCANO_DATABASE=app

# Complete after the first frontend deploy, using its URL from the CLI.
APP_BASE_URL=

# Each participant needs an authorized model credential or a facilitator proxy.
# This repository does not supply a proxy or hide a key from project admins.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Global lab mode. All signed-in users in this LaunchBrief project bypass credits.
LAUNCHBRIEF_CREDIT_GATE_ENABLED=false

# Trellini project: use its own service key and an actual board/column pair.
TRELLINI_API_URL=
TRELLINI_SERVICE_KEY=
TRELLINI_DATABASE=trellini
TRELLINI_BOARD_ID=
TRELLINI_COLUMN_ID=

# Stripe is intentionally omitted from the core lab.
